# HTTP port for model service
PORT=8100

# wastara-be base URL
BACKEND_URL=http://localhost:8000

# Must match INTERNAL_API_KEY in wastara-be
INTERNAL_API_KEY=change-me
.
# Only set this if OpenCV still blocks auth from a background thread.
# OPENCV_AVFOUNDATION_SKIP_AUTH=1

# Inference device: auto | cuda | mps | cpu
# DEVICE=auto

# Garment detector weights (relative to wastara-model root)
# MODEL_PATH=models/clothing/finetuned/yolov8n-conveyor-clothing.pt

# Detection thresholds
# CONFIDENCE_THRESHOLD=0.5
# IOU_THRESHOLD=0.45
